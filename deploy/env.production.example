# .env.production.example
#
# Copy this to /opt/paperclip/.env on the VPS and fill in real values.
# Real .env file: chmod 600, never committed, never leaves the VPS.

# Image tag to deploy. 'latest' tracks the production branch builds.
# To roll back: change to a sha-XXXXXXX tag from GHCR.
IMAGE_TAG=latest

# Render external Postgres URL (paste from Render dashboard)
DATABASE_URL=postgres://USER:PASSWORD@HOST.frankfurt-postgres.render.com/paperclip_380k

# Better Auth secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=GENERATE_ME
